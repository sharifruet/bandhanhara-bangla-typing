<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: same theme plus the system splash screen (the writing bird on cream). -->
    <style name="Theme.Bandhanhara" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/setup_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/setup_text</item>
        <item name="android:textColorSecondary">@color/setup_muted</item>
        <item name="android:windowSplashScreenBackground">@color/setup_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand_cream</item>
    </style>
</resources>
