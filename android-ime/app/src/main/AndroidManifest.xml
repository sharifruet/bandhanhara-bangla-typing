<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ package visibility: let the 🌐 key see the other installed keyboards. -->
    <queries>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Bandhanhara"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true">

        <!-- Setup / onboarding screen (also reachable from the system keyboard settings gear) -->
        <activity
            android:name=".SetupActivity"
            android:label="@string/launcher_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keyboard settings (toolbar ⚙, setup screen, and the gear in the system keyboard list) -->
        <activity
            android:name=".SettingsActivity"
            android:label="@string/settings_title"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:exported="true" />

        <!-- The keyboard itself -->
        <service
            android:name=".BanglaIMEService"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>

</manifest>
